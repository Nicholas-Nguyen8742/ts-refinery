# Postgres / Redis
DATABASE_URL=postgres://admin:admin@localhost:5432/refinery
REDIS_URL=redis://localhost:6379

# API
PORT=3000
PRESIGN_EXPIRES_SECONDS=3600
MAX_UPLOAD_BYTES=524288000

# S3 / MinIO
S3_BUCKET=refinery-docs
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin123
S3_FORCE_PATH_STYLE=true

# Parser worker (CPU-bound: keep concurrency low)
PARSER_CONCURRENCY=2

# Embedder worker (I/O-bound: higher concurrency is fine)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=256
EMBEDDER_CONCURRENCY=8
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
